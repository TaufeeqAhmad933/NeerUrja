# ─── NeerUrja Frontend — Environment Variables ────────────────────────────────
#
# Copy this file to .env.local for local development overriding.
# NEVER commit credentials or secrets to frontend code or repository.

# Base URL of the NeerUrja backend API (no trailing slash).
# Local backend:  http://127.0.0.1:8000
# AWS API:        https://<api-id>.execute-api.<region>.amazonaws.com
VITE_API_BASE_URL=http://127.0.0.1:8000
